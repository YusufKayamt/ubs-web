# Bu dosyayı .env olarak kopyalayıp gerçek değerlerle doldur (asla .env'i paylaşma/commit etme).
# Vercel'de bu değerlerin aynısı Project Settings > Environment Variables altına girilir.

# Neon Dashboard > Connection Details (pooled connection string)
DATABASE_URL=postgresql://kullanici:SIFRE@ep-xxxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Vercel Dashboard > Storage > Blob store > .env.local sekmesi (vercel blob create-store ile otomatik eklenir)
BLOB_READ_WRITE_TOKEN=

JWT_SECRET=
ADMIN_USERNAME=ubsadmin
ADMIN_PASSWORD_HASH=

# Yerelde http://localhost:5173 gibi, canlıda gerçek domain
CORS_ORIGIN=http://localhost:5173

NODE_ENV=development
