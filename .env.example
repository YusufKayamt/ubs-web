# Bu dosyayı .env olarak kopyalayıp gerçek değerlerle doldur (asla .env'i paylaşma/commit etme).
# Vercel'de bu değerlerin aynısı Project Settings > Environment Variables altına girilir.

# Supabase Dashboard > Connect > Transaction pooler
DATABASE_URL=postgresql://postgres.xxxxx:SIFRE@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Supabase Dashboard > Project Settings > Data API
SUPABASE_URL=https://xxxxx.supabase.co
# Supabase Dashboard > Project Settings > API > service_role (gizli anahtar, asla frontend'e verilmez)
SUPABASE_SERVICE_ROLE_KEY=
# Storage > oluşturulan public bucket adı (varsayılan: gorseller)
SUPABASE_BUCKET=gorseller

JWT_SECRET=
ADMIN_USERNAME=ubsadmin
ADMIN_PASSWORD_HASH=

# Yerelde http://localhost:5173 gibi, canlıda gerçek domain
CORS_ORIGIN=http://localhost:5173

NODE_ENV=development
